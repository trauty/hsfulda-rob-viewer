# Slang to SPIRV to a generated header with the words as a constexpr array
# the host slangc compiles for every platform, nothing ships as an asset
#
#   robv_add_shaders(<target> FILES a.slang)
#   gives #include "robv/shaders/a.h" and robv::shaders::a
#
# one module per file holding every [shader(...)] entry point under its source name,
# so a vertex and fragment pair can share a file and be picked by pName
# matrices are column major, like the CPU side, so mul(m, v) reads as m * v in GLSL
#
# the same file runs in script mode (SPV, HEADER, SYMBOL) to write one header

if(CMAKE_SCRIPT_MODE_FILE)
    file(READ "${SPV}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR remainder "${hex_length} % 8")
    if(hex_length EQUAL 0 OR NOT remainder EQUAL 0)
        message(FATAL_ERROR "${SPV} is not a whole number of 32 bit words")
    endif()

    # SPIRV words are little endian on disk, the array holds their values
    string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1," words "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f]+,){8})" "\\1\n        " words "${words}")

    file(WRITE "${HEADER}"
        "// generated by RobvShaders.cmake from ${SPV}, do not edit\n"
        "#pragma once\n\n"
        "#include \"robv/common/types.h\"\n\n"
        "namespace robv::shaders\n{\n"
        "    inline constexpr u32 ${SYMBOL}[] = {\n        ${words}\n    };\n"
        "} // namespace robv::shaders\n")
    return()
endif()

find_program(ROBV_SLANGC slangc
    HINTS "$ENV{VULKAN_SDK}/bin"
    NO_CMAKE_FIND_ROOT_PATH)

# no Vulkan SDK on the Jetson and no distro package, so fall back to a release build for the host
if(NOT ROBV_SLANGC AND NOT ROBV_USE_SYSTEM_DEPS)
    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(x86_64|aarch64)$")
        CPMAddPackage(
            NAME slang
            VERSION 2025.23.2
            URL "https://github.com/shader-slang/slang/releases/download/v2025.23.2/slang-2025.23.2-linux-${CMAKE_HOST_SYSTEM_PROCESSOR}.tar.gz"
            DOWNLOAD_ONLY YES)
        set(ROBV_SLANGC "${slang_SOURCE_DIR}/bin/slangc" CACHE FILEPATH "" FORCE)
    endif()
endif()

if(NOT ROBV_SLANGC)
    message(FATAL_ERROR "slangc not found, install the Vulkan SDK or set ROBV_SLANGC")
endif()

set(ROBV_SHADERS_SCRIPT "${CMAKE_CURRENT_LIST_FILE}")

function(robv_add_shaders target)
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "" "FILES")

    set(out_root "${CMAKE_CURRENT_BINARY_DIR}/shaders")
    set(headers)

    foreach(file IN LISTS arg_FILES)
        get_filename_component(source "${file}" ABSOLUTE)
        get_filename_component(name "${file}" NAME)
        get_filename_component(stem "${file}" NAME_WE)
        string(MAKE_C_IDENTIFIER "${stem}" symbol)

        set(spv "${out_root}/${symbol}.spv")
        set(header "${out_root}/robv/shaders/${symbol}.h")

        add_custom_command(
            OUTPUT "${spv}"
            COMMAND "${ROBV_SLANGC}" "${source}" -target spirv -profile spirv_1_5 -fvk-use-entrypoint-name
                -matrix-layout-column-major -O2 -warnings-as-errors all -depfile "${spv}.d" -o "${spv}"
            DEPENDS "${source}"
            DEPFILE "${spv}.d"
            COMMENT "slangc ${name}"
            VERBATIM)

        add_custom_command(
            OUTPUT "${header}"
            COMMAND "${CMAKE_COMMAND}" -DSPV=${spv} -DHEADER=${header} -DSYMBOL=${symbol} -P "${ROBV_SHADERS_SCRIPT}"
            DEPENDS "${spv}" "${ROBV_SHADERS_SCRIPT}"
            COMMENT "embed ${name}"
            VERBATIM)

        list(APPEND headers "${header}")
    endforeach()

    target_sources(${target} PRIVATE ${headers})
    target_include_directories(${target} PRIVATE "${out_root}")
endfunction()
